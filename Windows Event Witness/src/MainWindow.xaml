<Window x:Class="WindowsEventWitness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Event Witness" Width="1470" Height="840" MinWidth="1040" MinHeight="650"
        Style="{StaticResource {x:Type Window}}" Icon="WindowsEventWitness.ico"
        WindowStartupLocation="CenterScreen" Loaded="FirstLaunch" Closing="WindowClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="33"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
            <DockPanel LastChildFill="True">
                <Button Content="Settings" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Click="OpenSettings"/>
                <Button Content="Walkthrough" DockPanel.Dock="Right" VerticalAlignment="Center" Click="OpenWalkthrough"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="7" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                        <Grid Width="19" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Stroke="{StaticResource AccentInkBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 1,9 H 4 L 7,4 L 11,14 L 14,8 H 18"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Windows Event Witness" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="242"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="340" MinWidth="260" MaxWidth="650"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,21">
                        <TextBlock Text="CASE ACTIONS" Style="{StaticResource Label}" Margin="0,0,0,11"/>
                        <Button x:Name="CaptureButton" Content="Collect recent events" Style="{StaticResource PrimaryButton}" Click="CollectEvents" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                        <Button x:Name="OpenButton" Content="Open case" Click="OpenCase" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                        <Button x:Name="ImportButton" Content="Import EVTX" Click="ImportEvents" HorizontalContentAlignment="Left" Margin="0,0,0,7"/>
                        <Button x:Name="SaveButton" Content="Save case" Click="SaveCase" HorizontalContentAlignment="Left" Margin="0,0,0,7" IsEnabled="False"/>
                        <Button x:Name="DemoButton" Content="Load example case" Click="LoadExample" HorizontalContentAlignment="Left"/>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,15"/>
                        <TextBlock Text="SOURCE COVERAGE" Style="{StaticResource Label}" Margin="0,0,0,9"/>
                        <TextBlock x:Name="CoverageEmpty" Text="Sources and collection gaps appear here when you open a case." Style="{StaticResource Muted}" FontSize="13"/>
                        <ItemsControl x:Name="CoverageList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="5" Padding="8" Margin="0,0,0,7">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Source}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding State}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Count, StringFormat={}{0:N0} records retained}" Style="{StaticResource Muted}" FontSize="11"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="1" Margin="22,21,14,17">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,15">
                    <TextBlock x:Name="CaseTitle" Text="No case open" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CaseInfo" Text="Collect local events, open a saved case, or explore the example." Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                </StackPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock x:Name="FilterCount" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,1,0" Style="{StaticResource Muted}"/>
                    <TextBlock Text="Filter timeline" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,9,0" Style="{StaticResource Muted}"/>
                    <TextBox x:Name="FilterBox" AutomationProperties.Name="Filter timeline" TextChanged="FilterChanged" MinWidth="115"/>
                </DockPanel>
                <TabControl x:Name="Sections" Grid.Row="2">
                    <TabItem x:Name="TimelineTab" Header="Timeline">
                        <DataGrid x:Name="TimelineGrid" Margin="0,8,0,0" SelectionChanged="TimelineSelected" AutomationProperties.Name="Event timeline">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time (UTC)" Binding="{Binding Time}" Width="150"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="86"/>
                                <DataGridTextColumn Header="Activity" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="77"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Relationships">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="RelationshipGrid" SelectionChanged="RelationshipSelected" AutomationProperties.Name="Process relationships">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Origin" Binding="{Binding From}" Width="*"/>
                                    <DataGridTextColumn Header="Activity" Binding="{Binding To}" Width="*"/>
                                    <DataGridTextColumn Header="Evidence status" Binding="{Binding Certainty}" Width="111"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="1" x:Name="RelationshipCard" Visibility="Collapsed" Margin="0,10,0,0" Padding="12" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Button x:Name="EdgeFrom" Click="OpenEdgeFrom" HorizontalContentAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource AccentBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Button x:Name="EdgeTo" Grid.Column="2" Click="OpenEdgeTo" HorizontalContentAlignment="Left"/>
                                    <TextBlock x:Name="EdgeReason" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Findings">
                        <DataGrid x:Name="FindingGrid" Margin="0,8,0,0" SelectionChanged="FindingSelected" AutomationProperties.Name="Local findings">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="75"/>
                                <DataGridTextColumn Header="Finding" Binding="{Binding Kind}" Width="190"/>
                                <DataGridTextColumn Header="Reason to review" Binding="{Binding Detail}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Compare">
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button x:Name="BaselineButton" Content="Select baseline case" Click="SelectBaseline" HorizontalAlignment="Left" IsEnabled="False"/>
                                <TextBlock x:Name="ComparisonSummary" Text="Compare how often each event type was recorded in two cases." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                            </StackPanel>
                            <DataGrid x:Name="ComparisonGrid" AutomationProperties.Name="Baseline comparison">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Activity" Binding="{Binding Activity}" Width="*"/>
                                    <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" Width="75"/>
                                    <DataGridTextColumn Header="Baseline" Binding="{Binding Baseline}" Width="78"/>
                                    <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="78"/>
                                    <DataGridTextColumn Header="Delta" Binding="{Binding Delta}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
            <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}" ResizeBehavior="PreviousAndNext"/>
            <Grid Grid.Column="3" Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Margin="16,20,16,9">
                    <TextBlock Text="EVIDENCE INSPECTOR" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="InspectorTitle" Text="Select an event" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                </StackPanel>
                <TabControl x:Name="Inspector" Grid.Row="1" Margin="13,0,13,17">
                    <TabItem x:Name="OverviewTab" Header="Details">
                        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DetailPanel" Margin="8,6,8,9"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="RawTab" Header="Raw XML">
                        <TextBox x:Name="RawRecord" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="Original Windows event XML"/>
                    </TabItem>
                    <TabItem x:Name="ReviewTab" Header="Gemini">
                        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ReviewPanel" Margin="8,6,8,9"/>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,0">
            <DockPanel>
                <TextBlock Text="Nipun Dilshan Senevirathne" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="11"/>
                <TextBlock x:Name="Status" Text="Ready" VerticalAlignment="Center" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
